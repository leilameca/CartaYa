NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose this key with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=https://www.tucartaya.com

# Web Push VAPID. The public key may be exposed to browsers; keep the private key server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@your-domain.com

# Cloudflare R2 (server-only). Create an R2 Standard bucket and an Object Read & Write API token.
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=cartaya-menu-images
# Public bucket custom domain (recommended) or the temporary r2.dev development URL.
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://images.your-domain.com
NEXT_PUBLIC_SALES_WHATSAPP=

# Transactional plan notifications (server-only).
# Verify the exact domain used in TRANSACTIONAL_EMAIL_FROM in Resend.
RESEND_API_KEY=re_your-api-key
TRANSACTIONAL_EMAIL_FROM=CartaYa <notificaciones@updates.tucartaya.com>
TRANSACTIONAL_EMAIL_REPLY_TO=soporte@tucartaya.com
PLAN_NOTIFICATIONS_ADMIN_EMAIL=

# Meta WhatsApp Business Platform. Store numbers in international format.
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_PLAN_REQUEST_TEMPLATE=cartaya_plan_solicitado
WHATSAPP_PLAN_DECISION_TEMPLATE=cartaya_plan_actualizado
PLAN_NOTIFICATIONS_ADMIN_WHATSAPP=18090000000
